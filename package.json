{
  "name": "claude-second-brain",
  "version": "0.1.0",
  "description": "Personal knowledge database for Claude Code — destroy, compress, and resynthesize context across sessions",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "brain": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const f='dist/cli.js';const c=fs.readFileSync(f,'utf8');if(!c.startsWith('#!')){fs.writeFileSync(f,'#!/usr/bin/env node\\n'+c);fs.chmodSync(f,0o755)}\"",
    "dev": "tsx src/cli.ts",
    "brain": "tsx src/cli.ts",
    "test": "node --test dist/**/*.test.js",
    "import": "tsx src/cli.ts import",
    "search": "tsx src/cli.ts search",
    "export": "tsx src/cli.ts export",
    "export:sync": "tsx src/cli.ts export --sync"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
